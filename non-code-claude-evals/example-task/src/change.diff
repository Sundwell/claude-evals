diff --git a/shelf/loans.py b/shelf/loans.py
index 9eca946..570fd39 100644
--- a/shelf/loans.py
+++ b/shelf/loans.py
@@ -4,6 +4,9 @@ from datetime import date, timedelta
 
 LOAN_DAYS = 21
 FINE_PER_DAY = 0.25
+FINE_CAP = 5.00
+MAX_RENEWALS = 2
+RENEW_DAYS = 14
 
 
 @dataclass
@@ -13,6 +16,11 @@ class Loan:
     start: date
     due: date
     returned: date | None = None
+    renewals: int = 0
+
+
+class RenewalRefused(Exception):
+    pass
 
 
 def open_loan(book, reader, today):
@@ -25,4 +33,16 @@ def days_late(loan, today):
 
 
 def fine(loan, today):
-    return round(days_late(loan, today) * FINE_PER_DAY, 2)
+    amount = round(days_late(loan, today) * FINE_PER_DAY, 2)
+    if loan.returned:
+        amount = min(amount, FINE_CAP)
+    return amount
+
+
+def renew(loan, today):
+    if days_late(loan, today) > 0:
+        raise RenewalRefused("the loan is late")
+    if loan.renewals > MAX_RENEWALS:
+        raise RenewalRefused(f"already renewed {loan.renewals} times")
+    loan.due = today + timedelta(days=RENEW_DAYS)
+    loan.renewals += 1
